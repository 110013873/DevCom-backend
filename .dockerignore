# 构建产物与依赖：镜像内重新安装/编译，不需要从宿主带进来
node_modules
dist
coverage
*.log

# 密钥与本地配置：绝不进镜像。密钥改由容器运行时以环境变量注入
# （见 config.ts 的 readResource），把私钥烤进镜像等于把签发能力
# 随镜像分发到每一台拉过它的机器。
.env
.env.*
!.env.example
src/resource/private.key
src/resource/public.pem

# 本地存储的临时目录
var/

# 版本控制与编辑器杂物
.git
.github
.vscode
.idea
.DS_Store
