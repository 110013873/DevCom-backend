# ── 数据库 ──
DB_URL=postgresql://postgres:postgres@localhost:5432/devcom
DB_SCHEMA=service

# ── 令牌 ──
# 访问令牌有效期（秒）
TOKEN_EXPIRE_IN=86400

# ── JWT 签名密钥（RS256）──
# 二选一：本地开发放文件（src/resource/private.key + public.pem），
# 容器部署用环境变量注入（不要把私钥烤进镜像）。
# 环境变量里的换行可用字面量 \n 表示，启动时会自动还原。
# 生成：openssl genrsa -out private.key 2048
#       openssl rsa -in private.key -pubout -out public.pem
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ── 运行端口（也可用 PORT 环境变量覆盖）──
PORT=10100
LOG_LEVEL=debug

# ── 本地缓存目录（本地存储模式使用）──
CACHE_MODE=local
CACHE_VIDEO_PATH=./var/clips/video
CACHE_AUDIO_PATH=./var/clips/audio
CACHE_IMAGE_PATH=./var/clips/image
CACHE_DOC_PATH=./var/clips/docs
CACHE_UPLOAD_TMP_PATH=./var/clips/tmp

# ── 阿里云 OSS（留空则退化为本地存储）──
OSS_REGION=
OSS_ENDPOINT=
OSS_SECURE=true
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── 阿里云短信（注册/登录验证码）──
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ── 邮件 SMTP（邮箱验证码、订阅确认）──
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TileLang for RISC-V 社区 <noreply@tlaic.ac.cn>

# ── 站点 ──
FRONTEND_URL=http://localhost:8081

# 本地开发：未配置 SMTP/短信时把验证码打印到服务端日志（生产保持注释）
# OTP_DEV_ECHO=true

# 初始系统管理员（首次部署时注入，创建后可从 .env 移除；请使用强密码）
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=系统管理员
