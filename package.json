{
  "name": "devcom-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TileLang for RISC-V 社区后端服务",
  "scripts": {
    "build": "rm -rf dist/ && tsc && cp -r src/resource dist",
    "start": "node dist/index.js",
    "dev": "npm run build && cross-env NODE_ENV=dev npm start",
    "start:dev": "npm run build && nodemon dist/index.js",
    "migration:generate": "npm run build && typeorm migration:generate -d ormconfig.js",
    "migration:run": "npm run build && typeorm migration:run -d ormconfig.js",
    "migration:revert": "npm run build && typeorm migration:revert -d ormconfig.js",
    "migration:create": "typeorm migration:create"
  },
  "engines": {
    "node": "18.19.0"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^2.0.24",
    "@types/node-cron": "^3.0.11",
    "ali-oss": "^6.23.0",
    "axios": "^1.6.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "common-db-node": "github:110013873/common-db-node",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "9.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "routing-controllers": "^0.10.4",
    "typeorm": "^0.3.17",
    "uuid": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^18.19.0",
    "@types/nodemailer": "^6.4.24",
    "@types/uuid": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
